
(rules PCB freerouting.dsn
  (snap_angle 
    fortyfive_degree
  )
  (rule
    (width 200.0)
    (clearance 200.0)
    (clearance 100.0 (type smd_to_turn_gap))
    (clearance 50.0 (type smd))
    (clearance 200.0 (type "kicad_default"))
  )
  (padstack "Via[0-1]_600:300_um"
    (shape
      (circle F.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 600.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_600:300_um" "Via[0-1]_600:300_um" default
  )
  (via 
    "Via[0-1]_600:300_um-kicad_default" "Via[0-1]_600:300_um" "kicad_default"
  )
  (via_rule
    default "Via[0-1]_600:300_um"
  )
  (via_rule
    "kicad_default" "Via[0-1]_600:300_um-kicad_default"
  )
  (class default
    (clearance_class default)
    (via_rule default)
    (rule
      (width 200.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class "kicad_default"
    "/LED_GND" "Net-(LED12-DOUT)" "/LED_5V" "Net-(LED4-DIN)" "Net-(R1-Pad1)" "Net-(D3-A)" "Net-(D1-A)" "Net-(LED15-DOUT)"
    "Net-(LED12-DIN)" "Net-(LED5-DOUT)" "Net-(LED13-DIN)" "Net-(D4-A)" "Net-(LED1-DOUT)" "Net-(R3-Pad1)" "Net-(D9-A)" /5V
    "Net-(R4-Pad1)" "Net-(D15-A)" "Net-(R2-Pad1)" "Net-(D7-A)" "Net-(LED3-DOUT)" "Net-(LED11-DIN)" "Net-(D13-A)" "Net-(LED14-DIN)"
    "Net-(LED10-DIN)" "Net-(LED2-DIN)" "Net-(LED2-DOUT)" "Net-(D5-A)" "Net-(D12-A)" "Net-(D8-A)" "Net-(LED11-DOUT)" "Net-(S1-VCC)"
    "Net-(S1-SCL)" "Net-(S1-SDA)" "Net-(D14-A)" "Net-(LED19-DIN)" "Net-(LED1-DIN)" "Net-(LED10-DOUT)" "Net-(D11-A)" "Net-(U1-PA6_A10_D10_MOSI)"
    "Net-(U1-PA5_A9_D9_MISO)" "unconnected-(ENCDR_LEFT1-PadS1)" "unconnected-(ENCDR_LEFT1-PadS2)" "Net-(U1-PB09_A7_D7_RX)" "unconnected-(ENCDR_RIGHT1-PadS1)" "unconnected-(ENCDR_RIGHT1-PadS2)" "Net-(D10-A)" "Net-(LED13-DOUT)"
    "Net-(D6-A)" "Net-(D16-A)" "Net-(D2-A)" "Net-(D10-K)" "Net-(D1-K)" "Net-(D11-K)" "Net-(D12-K)" "Net-(LED19-DOUT)"
    "unconnected-(LED20-DOUT-Pad4)" "/row1_2" "/row3_4" "/col3_4" "Net-(LED17-DIN)" "Net-(U1-PB08_A6_D6_TX)" "/col1_2" "Net-(U1-PA7_A8_D8_SCK)"
    "/an_GND"
    (clearance_class "kicad_default")
    (via_rule "kicad_default")
    (rule
      (width 200.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)